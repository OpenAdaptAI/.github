{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qualification-release-verification-receipt-v2.schema.json",
  "title": "OpenAdapt product release verification receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "verification_id_sha256",
    "verdict",
    "evidence_class",
    "target",
    "claim_scope",
    "admission_object_sha256",
    "admission_bundle_object_sha256",
    "admission_id_sha256",
    "release_sha256",
    "artifact_inventory_sha256",
    "release_identity",
    "release_kind",
    "source_repository",
    "source_repository_id",
    "source_commit",
    "version",
    "tag",
    "deployment_id",
    "deployment_sha256",
    "draft_release_id",
    "publication_staging_sha256",
    "authority_state_sha256",
    "revocation_state_sha256",
    "signer_registry_sha256",
    "acceptance_summary_object_sha256",
    "acceptance_manifest_object_sha256",
    "decision_receipt_object_sha256",
    "qualification_admission_object_sha256",
    "qualification_admission_id_sha256",
    "workflow_version_id_sha256",
    "workflow_bundle_sha256",
    "admitted_runtime_sha256",
    "verified_at",
    "expires_at",
    "registry_source_commit",
    "registry_revision",
    "registry_head_sha256",
    "trust_state_source_commit"
  ],
  "properties": {
    "schema_version": {"const": "openadapt.qualification-release-verification-receipt/v2"},
    "verification_id_sha256": {"$ref": "#/$defs/digest"},
    "verdict": {"const": "verified"},
    "evidence_class": {"const": "remote-safe-synthetic"},
    "target": {"enum": ["agent", "capture", "cloud", "desktop", "docs", "flow", "openadapt"]},
    "claim_scope": {"type": "string", "pattern": "^production_[a-z]+$"},
    "admission_object_sha256": {"$ref": "#/$defs/digest"},
    "admission_bundle_object_sha256": {"$ref": "#/$defs/digest"},
    "admission_id_sha256": {"$ref": "#/$defs/digest"},
    "release_sha256": {"$ref": "#/$defs/digest"},
    "artifact_inventory_sha256": {"$ref": "#/$defs/digest"},
    "release_identity": {"$ref": "qualification-release.schema.json#/$defs/release_identity"},
    "release_kind": {"enum": ["package", "deployment", "hybrid"]},
    "source_repository": {"type": "string", "pattern": "^OpenAdaptAI/[A-Za-z0-9._-]+$"},
    "source_repository_id": {"$ref": "#/$defs/decimal_id"},
    "source_commit": {"$ref": "#/$defs/commit"},
    "version": {"oneOf": [{"$ref": "#/$defs/version"}, {"type": "null"}]},
    "tag": {"oneOf": [{"$ref": "#/$defs/tag"}, {"type": "null"}]},
    "deployment_id": {"oneOf": [{"$ref": "#/$defs/decimal_id"}, {"type": "null"}]},
    "deployment_sha256": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "draft_release_id": {"$ref": "#/$defs/decimal_id"},
    "publication_staging_sha256": {"$ref": "#/$defs/digest"},
    "authority_state_sha256": {"$ref": "#/$defs/digest"},
    "revocation_state_sha256": {"$ref": "#/$defs/digest"},
    "signer_registry_sha256": {"$ref": "#/$defs/digest"},
    "acceptance_summary_object_sha256": {"$ref": "#/$defs/digest"},
    "acceptance_manifest_object_sha256": {"$ref": "#/$defs/digest"},
    "decision_receipt_object_sha256": {"$ref": "#/$defs/digest"},
    "qualification_admission_object_sha256": {"$ref": "#/$defs/digest"},
    "qualification_admission_id_sha256": {"$ref": "#/$defs/digest"},
    "workflow_version_id_sha256": {"$ref": "#/$defs/digest"},
    "workflow_bundle_sha256": {"$ref": "#/$defs/digest"},
    "admitted_runtime_sha256": {"$ref": "#/$defs/digest"},
    "verified_at": {"$ref": "#/$defs/timestamp"},
    "expires_at": {"$ref": "#/$defs/timestamp"},
    "registry_source_commit": {"$ref": "#/$defs/commit"},
    "registry_revision": {"type": "integer", "minimum": 1},
    "registry_head_sha256": {"$ref": "#/$defs/digest"},
    "trust_state_source_commit": {"$ref": "#/$defs/commit"}
  },
  "oneOf": [
    {"$ref": "#/$defs/agent"},
    {"$ref": "#/$defs/capture"},
    {"$ref": "#/$defs/cloud"},
    {"$ref": "#/$defs/desktop"},
    {"$ref": "#/$defs/docs"},
    {"$ref": "#/$defs/flow"},
    {"$ref": "#/$defs/openadapt"}
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "decimal_id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,9})\\.(0|[1-9][0-9]{0,9})\\.(0|[1-9][0-9]{0,9})(-[0-9A-Za-z]+([.-][0-9A-Za-z]+)*)?$"},
    "tag": {"type": "string", "pattern": "^v(0|[1-9][0-9]{0,9})\\.(0|[1-9][0-9]{0,9})\\.(0|[1-9][0-9]{0,9})(-[0-9A-Za-z]+([.-][0-9A-Za-z]+)*)?$"},
    "package_identity": {
      "properties": {
        "release_kind": {"const": "package"},
        "version": {"$ref": "#/$defs/version"},
        "tag": {"$ref": "#/$defs/tag"},
        "deployment_id": {"type": "null"},
        "deployment_sha256": {"type": "null"}
      }
    },
    "deployment_identity": {
      "properties": {
        "release_kind": {"const": "deployment"},
        "version": {"type": "null"},
        "tag": {"type": "null"},
        "deployment_id": {"$ref": "#/$defs/decimal_id"},
        "deployment_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "hybrid_identity": {
      "properties": {
        "release_kind": {"const": "hybrid"},
        "version": {"$ref": "#/$defs/version"},
        "tag": {"$ref": "#/$defs/tag"},
        "deployment_id": {"$ref": "#/$defs/decimal_id"},
        "deployment_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "agent": {
      "allOf": [
        {"$ref": "#/$defs/package_identity"},
        {"properties": {"target": {"const": "agent"}, "claim_scope": {"const": "production_agent"}, "source_repository": {"const": "OpenAdaptAI/openadapt-agent"}, "source_repository_id": {"const": "1136136670"}}}
      ]
    },
    "capture": {
      "allOf": [
        {"$ref": "#/$defs/package_identity"},
        {"properties": {"target": {"const": "capture"}, "claim_scope": {"const": "production_capture"}, "source_repository": {"const": "OpenAdaptAI/openadapt-capture"}, "source_repository_id": {"const": "1115283835"}}}
      ]
    },
    "cloud": {
      "allOf": [
        {"$ref": "#/$defs/deployment_identity"},
        {"properties": {"target": {"const": "cloud"}, "claim_scope": {"const": "production_cloud"}, "source_repository": {"const": "OpenAdaptAI/openadapt-cloud"}, "source_repository_id": {"const": "1300570990"}}}
      ]
    },
    "desktop": {
      "allOf": [
        {"$ref": "#/$defs/hybrid_identity"},
        {"properties": {"target": {"const": "desktop"}, "claim_scope": {"const": "production_desktop"}, "source_repository": {"const": "OpenAdaptAI/openadapt-desktop"}, "source_repository_id": {"const": "1171291730"}}}
      ]
    },
    "docs": {
      "allOf": [
        {"$ref": "#/$defs/deployment_identity"},
        {"properties": {"target": {"const": "docs"}, "claim_scope": {"const": "production_docs"}, "source_repository": {"const": "OpenAdaptAI/openadapt-ops"}, "source_repository_id": {"const": "1172011294"}}}
      ]
    },
    "flow": {
      "allOf": [
        {"$ref": "#/$defs/package_identity"},
        {"properties": {"target": {"const": "flow"}, "claim_scope": {"const": "production_flow"}, "source_repository": {"const": "OpenAdaptAI/openadapt-flow"}, "source_repository_id": {"const": "1291376938"}}}
      ]
    },
    "openadapt": {
      "allOf": [
        {"$ref": "#/$defs/package_identity"},
        {"properties": {"target": {"const": "openadapt"}, "claim_scope": {"const": "production_openadapt"}, "source_repository": {"const": "OpenAdaptAI/OpenAdapt"}, "source_repository_id": {"const": "627024850"}}}
      ]
    }
  }
}
